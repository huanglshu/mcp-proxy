# Copy to secret.yaml and fill in real values. Do not commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-proxy-secrets
  namespace: kube-ops
  labels:
    app: mcp-proxy
    app.kubernetes.io/name: mcp-proxy
type: Opaque
stringData:
  # Example: token used by a named server when --pass-environment is enabled
  GITHUB_PERSONAL_ACCESS_TOKEN: "replace-me"

  # Oracle MCP (required for /servers/oracle/)
  # Format: username/password@host:port/service_name
  ORACLE_CONNECTION_STRING: "app_user/password@oracle-host:1521/ORCLPDB1"
  # Optional overrides (also settable in ConfigMap servers.json env)
  # TARGET_SCHEMA: "APP_OWNER"
  # READ_ONLY_MODE: "1"
  # THICK_MODE: "1"
  # ORACLE_CLIENT_LIB_DIR: "/opt/oracle/instantclient_19_31"
