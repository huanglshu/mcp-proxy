# Copy to secret.yaml and fill in real values. Do not commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-proxy-secrets
  namespace: mcp-proxy
  labels:
    app: mcp-proxy
    app.kubernetes.io/name: mcp-proxy
type: Opaque
stringData:
  # Example: token used by a named server when --pass-environment is enabled
  GITHUB_PERSONAL_ACCESS_TOKEN: "replace-me"
